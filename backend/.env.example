# Copia este archivo como ".env" y completa con tus datos reales
# Cadena de conexion de MongoDB Atlas (la obtienes al crear tu cluster gratuito)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/incidapp

# Clave secreta para firmar los tokens JWT (invéntate una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta

# Puerto donde correra el servidor
PORT=3000
